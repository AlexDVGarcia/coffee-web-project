{
  "$description": "Tokens de design do coffee-web-project no formato W3C Design Tokens (DTCG). Fonte para Figma/Tokens Studio. A implementação de referência é tokens.css.",
  "color": {
    "$type": "color",
    "espresso": { "$value": "#1E1410", "$description": "Fundo escuro; texto principal no tema papel" },
    "roast": { "$value": "#2C211B", "$description": "Superfície elevada no tema torra; letras do padrão" },
    "oxblood": { "$value": "#3D110E", "$description": "Bloco de cor profundo; hover da ação primária no claro" },
    "crema": { "$value": "#EBD9BF", "$description": "Texto no escuro; superfície elevada no claro" },
    "paper": { "$value": "#F5F0E7", "$description": "Fundo do tema papel" },
    "olive": { "$value": "#4B5531", "$description": "Acento principal; anel de foco no claro" },
    "moss": { "$value": "#3E4A26", "$description": "Hover do oliva" },
    "rose": { "$value": "#D48A92", "$description": "Acento secundário — só preenchimento; anel de foco no escuro" },
    "cacao": { "$value": "#6E5A4C", "$description": "Texto secundário no claro (5.7:1 sobre paper)" },
    "steam": { "$value": "#B9A894", "$description": "Texto secundário no escuro (7.8:1 sobre espresso)" },
    "ember": { "$value": "#A3352B", "$description": "Erro e ações destrutivas" }
  },
  "semantic": {
    "paper": {
      "surface-base": { "$type": "color", "$value": "{color.paper}" },
      "surface-raised": { "$type": "color", "$value": "{color.crema}" },
      "surface-inverse": { "$type": "color", "$value": "{color.espresso}" },
      "ink": { "$type": "color", "$value": "{color.espresso}" },
      "ink-muted": { "$type": "color", "$value": "{color.cacao}" },
      "ink-inverse": { "$type": "color", "$value": "{color.crema}" },
      "action": { "$type": "color", "$value": "{color.espresso}" },
      "action-hover": { "$type": "color", "$value": "{color.oxblood}" },
      "action-ink": { "$type": "color", "$value": "{color.crema}" },
      "focus": { "$type": "color", "$value": "{color.olive}" },
      "danger": { "$type": "color", "$value": "{color.ember}" }
    },
    "roast": {
      "surface-base": { "$type": "color", "$value": "{color.espresso}" },
      "surface-raised": { "$type": "color", "$value": "{color.roast}" },
      "surface-inverse": { "$type": "color", "$value": "{color.crema}" },
      "ink": { "$type": "color", "$value": "{color.crema}" },
      "ink-muted": { "$type": "color", "$value": "{color.steam}" },
      "ink-inverse": { "$type": "color", "$value": "{color.espresso}" },
      "action": { "$type": "color", "$value": "{color.crema}" },
      "action-hover": { "$type": "color", "$value": "{color.paper}" },
      "action-ink": { "$type": "color", "$value": "{color.espresso}" },
      "focus": { "$type": "color", "$value": "{color.rose}" },
      "danger": { "$type": "color", "$value": "#E07A6E" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Instrument Sans", "ui-sans-serif", "system-ui", "sans-serif"] },
      "display": { "$value": ["Bowlby One", "Instrument Sans", "sans-serif"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    }
  },
  "text": {
    "$type": "dimension",
    "caption": { "$value": "12px", "lineHeight": 1.4 },
    "small": { "$value": "14px", "lineHeight": 1.45 },
    "body": { "$value": "16px", "lineHeight": 1.55 },
    "lead": { "$value": "18px", "lineHeight": 1.5 },
    "h4": { "$value": "21px", "lineHeight": 1.3 },
    "h3": { "$value": "24px", "lineHeight": 1.2 },
    "h2": { "$value": "28px→36px", "lineHeight": 1.08 },
    "h1": { "$value": "36px→48px", "lineHeight": 1.04 },
    "display": { "$value": "60px→96px", "lineHeight": 0.92 },
    "poster": { "$value": "80px→192px", "lineHeight": 0.82 }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "6px" },
    "card": { "$value": "18px" },
    "panel": { "$value": "28px" },
    "full": { "$value": "9999px" }
  },
  "space": {
    "$type": "dimension",
    "base": { "$value": "4px", "$description": "Unidade do Tailwind (--spacing). Use múltiplos: 1=4px, 2=8px, 4=16px…" },
    "gutter": { "$value": "16px→40px" },
    "section": { "$value": "64px→144px" },
    "panel": { "$value": "20px→48px" },
    "bento": { "$value": "12px→24px" }
  },
  "border": {
    "$type": "dimension",
    "rule": { "$value": "1px" },
    "control": { "$value": "1.5px" }
  },
  "shadow": {
    "$type": "shadow",
    "overlay": { "$value": { "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-16px", "color": "#1E141073" } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "200ms" },
      "slow": { "$value": "360ms" },
      "reveal": { "$value": "640ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "pour": { "$value": [0.2, 0.7, 0.2, 1] },
      "snap": { "$value": [0.3, 0, 0.2, 1] }
    }
  }
}
